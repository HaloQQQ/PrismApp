<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="clr-namespace:MusicPlayerModule.Contracts">
    <ObjectDataProvider
        x:Key="OrdersData"
        MethodName="GetValues"
        ObjectType="{x:Type contracts:EnumOrderType}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="contracts:EnumOrderType" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <Style
        x:Key="PointABTextBlock"
        BasedOn="{StaticResource TextBlock_Theme}"
        TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />

        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="MediaProgressSlider"
        BasedOn="{StaticResource {x:Type Slider}}"
        TargetType="Slider">
        <Setter Property="Margin" Value="2,0" />

        <Setter Property="Width" Value="1500" />
        <Setter Property="Height" Value="3" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentMedia}" Value="{x:Null}">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <GeometryGroup x:Key="PopupGeometryGroup_PlayOrder">
        <RectangleGeometry RadiusX="16" RadiusY="16">
            <RectangleGeometry.Rect>
                <Rect Width="150" Height="293" />
            </RectangleGeometry.Rect>
        </RectangleGeometry>
        <PathGeometry Figures="M65,293 L75,303 L85,293 Z" />
    </GeometryGroup>

    <GeometryGroup x:Key="PopupGeometryGroup_VideoStretchMode">
        <RectangleGeometry RadiusX="16" RadiusY="16">
            <RectangleGeometry.Rect>
                <Rect Width="100" Height="170" />
            </RectangleGeometry.Rect>
        </RectangleGeometry>
        <PathGeometry Figures="M40,170 L50,180 L60,170 Z" />
    </GeometryGroup>

    <GeometryGroup x:Key="PopupGeometryGroup_Volume">
        <RectangleGeometry RadiusX="6" RadiusY="6">
            <RectangleGeometry.Rect>
                <Rect Width="65" Height="190" />
            </RectangleGeometry.Rect>
        </RectangleGeometry>
        <PathGeometry Figures="M25,190 L32.5,196 L40,190 Z" />
    </GeometryGroup>

    <GeometryGroup x:Key="PopupGeometryGroup_MediaSpeedRatio">
        <RectangleGeometry RadiusX="16" RadiusY="16">
            <RectangleGeometry.Rect>
                <Rect Width="280" Height="90" />
            </RectangleGeometry.Rect>
        </RectangleGeometry>
        <PathGeometry Figures="M130,90 L140,100 L150,90 Z" />
    </GeometryGroup>

    <Style
        x:Key="Love"
        BasedOn="{StaticResource ToggleButton_Icon_Fill}"
        TargetType="ToggleButton">
        <Setter Property="MyAttachProperty.SelectedForeground" Value="{StaticResource OrangeRed}" />

        <Setter Property="Content" Value="&#xe644;" />
        <Setter Property="ToolTip" Value="收藏" />

        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="&#xe684;" />
                <Setter Property="ToolTip" Value="取消收藏" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MusicImage" TargetType="Image">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />

        <Setter Property="Margin" Value="5" />

        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />

        <Setter Property="Source" Value="{Binding CurrentMedia.Music.ImageSource}" />

        <Setter Property="Clip">
            <Setter.Value>
                <RectangleGeometry
                    RadiusX="5"
                    RadiusY="5"
                    Rect="0,0,60,60" />
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentMedia.Music.ImageSource}" Value="{x:Null}">
                <Setter Property="Source">
                    <Setter.Value>
                        <BitmapImage UriSource="/MusicPlayerModule;component/Resources/音符SVG-87.png" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="TogBtnPlayOrder"
        BasedOn="{StaticResource ButtonBase_Icon_Small_HoverBlue}"
        TargetType="ToggleButton">
        <Setter Property="IsChecked" Value="{Binding IsEditingPlayOrder}" />

        <Setter Property="Margin" Value="2,0" />
        <Setter Property="ToolTip" Value="{Binding CurrentPlayOrder}" />

        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentPlayOrder}" Value="{x:Static contracts:EnumOrderType.Order}">
                <Setter Property="Content" Value="&#xe871;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayOrder}" Value="{x:Static contracts:EnumOrderType.Loop}">
                <Setter Property="Content" Value="&#xe66c;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayOrder}" Value="{x:Static contracts:EnumOrderType.Random}">
                <Setter Property="Content" Value="&#xe66b;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayOrder}" Value="{x:Static contracts:EnumOrderType.SingleCycle}">
                <Setter Property="Content" Value="&#xe66d;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayOrder}" Value="{x:Static contracts:EnumOrderType.SingleOnce}">
                <Setter Property="Content" Value="&#xe621;" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="LstbxPlayOrder"
        BasedOn="{StaticResource {x:Type ListBox}}"
        TargetType="ListBox">
        <Setter Property="ItemsSource" Value="{Binding Source={StaticResource OrdersData}}" />
        <Setter Property="SelectedItem" Value="{Binding CurrentPlayOrder}" />

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0,10" />

                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate DataType="contracts:EnumOrderType">
                                <TextBlock
                                    Margin="30,10"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    Style="{StaticResource TextBlock_Theme_Icon_MouseOver}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.Order}">
                                                        <Setter Property="Text" Value="&#xe871;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.Loop}">
                                                        <Setter Property="Text" Value="&#xe66c;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.Random}">
                                                        <Setter Property="Text" Value="&#xe66b;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.SingleCycle}">
                                                        <Setter Property="Text" Value="&#xe66d;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.SingleOnce}">
                                                        <Setter Property="Text" Value="&#xe621;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.Order}">
                                                        <Setter Property="Text" Value="顺序播放" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.Loop}">
                                                        <Setter Property="Text" Value="循环播放" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.Random}">
                                                        <Setter Property="Text" Value="随机播放" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.SingleCycle}">
                                                        <Setter Property="Text" Value="单曲循环" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Static contracts:EnumOrderType.SingleOnce}">
                                                        <Setter Property="Text" Value="单曲播放" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </TextBlock>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>