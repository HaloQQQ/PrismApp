<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/IceTea.Wpf.Core;component/Resources/CustomColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  覆盖主色调为秋季的暖棕/暗金  -->
    <Color x:Key="DeepBlueColor">#FF4B3621</Color>
    <Color x:Key="ShallowBlueColor">#FFDAA520</Color>

    <SolidColorBrush x:Key="TextBox.Background" Color="#664B3621" />
    <SolidColorBrush x:Key="TextBox.ReadOnly.Background" Color="#884B3621" />
    <SolidColorBrush x:Key="TextBox.Disable.Background" Color="#AA2E211D" />
    <SolidColorBrush x:Key="TextBox.BorderBrush" Color="#88DAA520" />
    <SolidColorBrush x:Key="TextBox.Focused.BorderBrush" Color="#FFFFD700" />

    <SolidColorBrush x:Key="TextBlock.PlaceHolder.Foreground" Color="#CCDAA520" />

    <!--  修改点1：文本改为暖白（Cornsilk）  -->
    <SolidColorBrush x:Key="TextBlock.Foreground" Color="#FFFFF8DC" />

    <SolidColorBrush x:Key="BackPanel.Background" Color="#EE251B17" />

    <!--  修改点2：点缀色改为热橙红（OrangeRed），和文字形成对比  -->
    <SolidColorBrush x:Key="CheckBox.BorderBrush" Color="#FFFF4500" />
    <SolidColorBrush x:Key="CheckBox.Foreground" Color="#FFFF4500" />

    <SolidColorBrush x:Key="ComboBox.Background" Color="{StaticResource DeepBlueColor}" />
    <SolidColorBrush x:Key="ComboBox.BorderBrush" Color="{StaticResource ShallowBlueColor}" />

    <!--  高亮色使用亮金色（Gold），突出重点  -->
    <SolidColorBrush x:Key="HighLight.Foreground" Color="#FFFFD700" />

    <SolidColorBrush x:Key="Disable.Foreground" Color="#CC8A7A68" />
    <SolidColorBrush x:Key="Disable.Background" Color="#772E211D" />

    <SolidColorBrush x:Key="Theme.SolidBack" Color="#FF1B120E" />
</ResourceDictionary>