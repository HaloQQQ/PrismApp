<Window
    x:Class="MyApp.Prisms.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:regions="http://prismlibrary.com/"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:views="clr-namespace:MyApp.Prisms.Views"
    MinWidth="1200"
    MinHeight="640"
    prism:ViewModelLocator.AutoWireViewModel="True"
    MyAttachProperty.CornerRadius="{Binding Settings.CornerRadius}"
    Style="{StaticResource Window_WithShadow}">
    <Window.Background>
        <ImageBrush ImageSource="{Binding CurrentBkGrd}" Stretch="UniformToFill" />
    </Window.Background>

    <Grid Background="#33000000">
        <DockPanel>
            <views:WindowTitleBarView DockPanel.Dock="Top" />

            <Grid>
                <ContentControl prism:RegionManager.RegionName="MainWindowRegion" />

                <views:SettingsView>
                    <views:SettingsView.RenderTransform>
                        <TranslateTransform X="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </views:SettingsView.RenderTransform>
                    <views:SettingsView.Style>
                        <Style TargetType="views:SettingsView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.Settings.IsEditingSetting, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <ElasticEase
                                                            EasingMode="EaseOut"
                                                            Oscillations="2"
                                                            Springiness="5" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SettingsView.Style>
                </views:SettingsView>
            </Grid>
        </DockPanel>

        <views:SwitchBackgroundView HorizontalAlignment="Right" />
    </Grid>
</Window>