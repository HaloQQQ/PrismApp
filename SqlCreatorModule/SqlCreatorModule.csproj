<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>True</EnableWindowsTargeting>
    <Configurations>Debug;Release;ClickOnce</Configurations>
  </PropertyGroup>

  <Choose>
    <!-- 当使用 ClickOnce 配置时，仅编译 net8.0-windows -->
    <When Condition="'$(Configuration)' == 'ClickOnce'">
      <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
      </PropertyGroup>
    </When>
    <!-- 其他情况（Debug、Release 以及自定义配置），编译多版本 -->
    <Otherwise>
      <PropertyGroup>
        <TargetFrameworks>net462;net6.0-windows;net8.0-windows</TargetFrameworks>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <Folder Include="ExportModels\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IceTea.SqlStandard" Version="1.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrismAppBasicLib\PrismAppBasicLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="DBConfig.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
